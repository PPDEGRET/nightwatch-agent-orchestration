{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nightwatch/brief.schema.json",
  "title": "Nightwatch brief",
  "type": "object",
  "required": ["schema_version", "run_id", "title", "objective", "synthetic_demonstration", "allowed_paths", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "synthetic_demonstration": {"type": "boolean"},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_conditions": {
      "type": "object",
      "properties": {
        "max_tasks": {"type": "integer", "minimum": 1},
        "max_failures": {"type": "integer", "minimum": 1},
        "max_runtime_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "title", "kind", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["analysis", "implementation", "continuation", "review", "creative"]},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "number", "minimum": 0.05, "maximum": 86400},
        "retry": {
          "type": "object",
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
            "backoff_seconds": {"type": "number", "minimum": 0},
            "multiplier": {"type": "number", "minimum": 1},
            "max_backoff_seconds": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "model_route": {"type": "string"},
        "handoff_from": {"type": ["string", "null"]},
        "produce_handoff": {"type": "boolean"},
        "fresh_context": {"type": "boolean"},
        "settings": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
