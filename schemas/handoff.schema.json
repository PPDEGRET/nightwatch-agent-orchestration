{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nightwatch/handoff.schema.json",
  "title": "Nightwatch continuation handoff",
  "type": "object",
  "required": ["schema_version", "from_task", "completed", "next_step", "artifacts", "risks", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "from_task": {"type": "string", "minLength": 1},
    "completed": {"type": "string", "minLength": 1},
    "next_step": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
